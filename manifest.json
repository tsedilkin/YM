{
  "manifest_version": 3,
  "name": "Yandex Music Unfreeze",
  "description": "Убирает блокирующий floating-ui portal и возвращает скролл на Яндекс Музыке",
  "version": "1.1.0",
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.yandex.ru/*",
        "https://music.yandex.com/*"
      ],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://music.yandex.ru/*",
        "https://music.yandex.com/*"
      ],
      "js": ["content.js"],
      "css": ["unlock.css"],
      "run_at": "document_start"
    }
  ]
}
